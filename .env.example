# OMGX AI website — environment configuration
# Copy to .env.local for local development. Never commit real values.
# Every value below is a placeholder that must be supplied by OMGX AI.

# Public base URL of the site, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_OMGX_SITE_URL=http://localhost:3000

# Public contact details. Leave empty until OMGX AI approves them.
# When empty, the site shows "to be confirmed" instead of inventing details.
NEXT_PUBLIC_OMGX_CONTACT_EMAIL=
NEXT_PUBLIC_OMGX_CONTACT_PHONE=
NEXT_PUBLIC_OMGX_CONTACT_ADDRESS=
NEXT_PUBLIC_OMGX_LINKEDIN_URL=

# Server-only. HTTPS endpoint of the OMGX-approved enquiry delivery service
# (for example a form/webhook service set up specifically for this website).
# The /api/contact route forwards validated enquiries here as JSON.
# When empty, the form reports that online delivery is not configured yet.
OMGX_CONTACT_WEBHOOK_URL=

# Server-only. Optional bearer token sent to the webhook above.
OMGX_CONTACT_WEBHOOK_TOKEN=
