# OMGX AI website - environment configuration
# Copy to .env.local for local development. Never commit .env.local.

# Public base URL of the site, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_OMGX_SITE_URL=http://localhost:3000

# EmailJS (contact form). The form sends from the browser, so these are public values.
# They are also the built-in defaults in src/lib/emailjs.ts; set them only to override.
# The EmailJS private key is not needed by the site and must never be added to the repo.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_9hpjj0q
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=ehXae-xSQLsI4Hlb2
NEXT_PUBLIC_EMAILJS_TEMPLATE_NOTIFY=template_s3v35xt
NEXT_PUBLIC_EMAILJS_TEMPLATE_REPLY=template_7dsm5it
